# Cấu hình backend. Khởi động lại ứng dụng sau khi thay đổi file này.
# Biến môi trường hệ thống được ưu tiên hơn giá trị trong .env.

# Tài khoản quản trị mặc định của ứng dụng (không phải tài khoản PostgreSQL).
# Chỉ tạo khi database chưa có admin; sửa ở đây không đổi mật khẩu admin đã tồn tại.
# Đổi mật khẩu mặc định trước khi sử dụng thực tế.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Loại database: sqlite (file cục bộ) hoặc postgresql (máy chủ database).
DB_TYPE=sqlite
# Chỉ dùng cho SQLite. Đường dẫn tương đối tính từ backend/.
# Để trống sẽ dùng backend/data/exam.db. SQLite không cần user/mật khẩu.
SQLITE_PATH=data/exam.db

# Các tham số dưới đây chỉ dùng khi DB_TYPE=postgresql.
# Cần tạo database và tài khoản có quyền tạo bảng trước khi chạy backend.
# Địa chỉ máy chủ PostgreSQL và cổng kết nối (mặc định 5432).
DB_HOST=localhost
DB_PORT=5432
# Tên database cần kết nối.
DB_NAME=math_exam
# Tài khoản PostgreSQL; nhập mật khẩu thực tế vào DB_PASSWORD.
# Nếu mật khẩu chứa # hoặc khoảng trắng, đặt trong dấu nháy: DB_PASSWORD='mat khau#123'
DB_USER=postgres
DB_PASSWORD=
# SSL: để trống dùng mặc định driver; disable=tắt, prefer=ưu tiên, require=bắt buộc.
# verify-ca/verify-full dùng để xác thực chứng chỉ máy chủ.
DB_SSLMODE=

# Tùy chọn: bỏ dấu # để dùng URL thay cho các tham số kết nối ở trên.
# DATABASE_URL được ưu tiên hơn DB_TYPE, SQLITE_PATH và các tham số DB_*.
# Mật khẩu trong URL cần URL-encode các ký tự đặc biệt như @, #, /.
# DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/math_exam
# DATABASE_URL=sqlite:///data/exam.db
# Đường dẫn tương đối trong URL SQLite tính từ thư mục chạy lệnh.
